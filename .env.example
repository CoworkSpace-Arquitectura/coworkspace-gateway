# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Puerto HTTP
PORT=3000

# Clave para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave

# Origen permitido por CORS (el sitio web)
FRONTEND_URL=http://localhost:3010

# Límite de peticiones por minuto
RATE_LIMIT_PER_MINUTE=100

# Direcciones de los microservicios
SPACE_URL=http://localhost:3001
MEMBERSHIP_URL=http://localhost:3002
ACCESS_URL=http://localhost:3003
BOOKING_URL=http://localhost:3004
BILLING_URL=http://localhost:3005
COMMUNITY_URL=http://localhost:3006
NOTIFICATION_URL=http://localhost:3007
ANALYTICS_URL=http://localhost:3008
CURRENCY_URL=http://localhost:3009
